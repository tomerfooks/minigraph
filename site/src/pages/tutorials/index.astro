---
import Base from '../../layouts/Base.astro'
import { tutorials } from '../../data/tutorials'
---
<Base title="Tutorials — MiniGraph" description="Twelve runnable Go tutorials covering the patterns people build with LangGraph: ReAct, supervisor, plan-and-execute, reflection, corrective RAG, map-reduce, human-in-the-loop, durable execution, SSE, real models.">
  <div class="prose">
    <div class="eyebrow">Tutorials</div>
    <h1>The patterns people build with LangGraph, in Go</h1>
    <p class="lede">
      Each tutorial is a runnable <code>main.go</code> in the repository, shown on the page exactly as CI compiles it.
      No API keys: models are scripted so you can read the control flow. Every one ends with where the real model or
      store plugs in.
    </p>
    <div class="grid" style="margin-top:2rem">
      {tutorials.map((t) => (
        <a class="card link" href={`/tutorials/${t.slug}`}>
          <div class="tut-meta"><span class="pill go">{t.pattern}</span></div>
          <h3>{t.title}</h3>
          <p>{t.promise}</p>
        </a>
      ))}
    </div>
  </div>
</Base>
