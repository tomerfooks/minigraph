---
// One tutorial page: header, story, graph, real source, real output, notes.
import Base from '../layouts/Base.astro'
import Code from './Code.astro'
import { tutorials } from '../data/tutorials'
interface Props {
  title: string; pattern: string; primitives: string[]; slug: string
  source: string; output: string; description?: string
  prev?: { slug: string; title: string }; next?: { slug: string; title: string }
}
const { title, pattern, primitives, slug, source, output, prev, next } = Astro.props
const description = Astro.props.description ?? tutorials.find((t) => t.slug === slug)?.promise
---
<Base title={`${title} — MiniGraph tutorial`} description={description}>
  <article class="prose">
    <header class="tut-head">
      <div class="tut-meta">
        <span class="pill go">{pattern}</span>
        {primitives.map((p) => <span class="pill">{p}</span>)}
        <span class="pill amber">offline · no API key</span>
      </div>
      <h1>{title}</h1>
      <slot name="lede" />
    </header>

    <slot name="story" />

    <h2>The graph</h2>
    <slot name="graph" />

    <h2>Run it</h2>
    <Code lang="console" code={`$ go run ./examples/${slug}\n${output}`} />

    <h2>The code</h2>
    <p>This is <code>examples/{slug}/main.go</code> in the repository, imported at build time. CI compiles it.</p>
    <Code lang="go" label={`examples/${slug}/main.go`} code={source} />

    <slot name="notes" />

    <nav class="next">
      {prev ? <a href={`/tutorials/${prev.slug}`}>← {prev.title}</a> : <span></span>}
      {next ? <a href={`/tutorials/${next.slug}`}>{next.title} →</a> : <a href="/tutorials">All tutorials →</a>}
    </nav>
  </article>
</Base>
